**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# AI assistant / editor tooling
.claude/
.claude
CLAUDE.md

# Secrets - never commit real API keys
.env
.cursor/
.windsurf/
.aider*
.cache/claude*

# Firebase / Cloud Functions - platform config & secrets, never commit
# (firebase.json itself is safe to commit — it has no secrets, only project
# id mappings needed for `firebase deploy` to work for anyone cloning this).
google-services.json
GoogleService-Info.plist
lib/firebase_options.dart
functions/node_modules/
functions/.env
functions/.env.local
functions/.env.*.local
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
pubsub-debug.log
*firebase-adminsdk*.json
*service-account*.json
